<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/gamemode_hud/invoke_training/invoke_training.css" />
        <include src="file://{resources}/styles/custom_game/fonts.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/gamemode_hud/invoke_training/invoke_training.js" />
    </scripts>
    <Panel hittest="false" class="InvokeHud">
        <Button class="InvokeHudButton InvokeExitButton" id="invokeEnd" onactivate="stopTraining()">
            <Label text="#trainingEnd" />
        </Button>
        <Button class="InvokeHudButton InvokeRetryButton" id="invokeRetry" onactivate="retryTraining()">
            <Label text="#retryButton" />
        </Button>

        <Button class="InvokeShowStatsButton" id="invokeShowStats" onactivate="showInvokeStats()" style="visibility: collapse;">
            <Panel class="InvokeShowStatsIcon" />
        </Button>
        <Panel id="invokePerformanceHud" class="InvokePerformanceHud">
            <Panel class="InvokeHideStatsButton" id="invokeHideStats" hittest="true" onactivate="hideInvokeStats()" />
            <Panel class="InvokeStatRow"><Label text="#invokeSuccesses" /><Label id="invokeSuccessesValue" class="InvokeStatValue" text="0" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeMistakes" /><Label id="invokeMistakesValue" class="InvokeStatValue" text="0" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeAccuracy" /><Label id="invokeAccuracyValue" class="InvokeStatValue" text="0%" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeStreak" /><Label id="invokeStreakValue" class="InvokeStatValue" text="0" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeBestStreak" /><Label id="invokeBestStreakValue" class="InvokeStatValue" text="0" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeSpellsPerMinute" /><Label id="invokeSpmValue" class="InvokeStatValue" text="0.0" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeAverageTime" /><Label id="invokeAvgTimeValue" class="InvokeStatValue" text="0.000s" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeOrbsPerSpell" /><Label id="invokeOrbsValue" class="InvokeStatValue" text="0.00" /></Panel>
            <Panel class="InvokeStatRow"><Label text="#invokeSessionTime" /><Label id="invokeElapsedValue" class="InvokeStatValue" text="00:00" /></Panel>
        </Panel>

        <Panel id="invokeQueuePanel" class="InvokeQueuePanel">
            <Panel id="invokeTargetQueue" />
        </Panel>
    </Panel>
</root>
