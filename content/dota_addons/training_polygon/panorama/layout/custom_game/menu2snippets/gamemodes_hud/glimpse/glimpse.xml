<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/mainmenu_v2.css" />
        <include src="file://{resources}/styles/custom_game/menu2snippets/gamemodes_hud/glimpse/glimpse.css" />
        <include src="file://{resources}/styles/custom_game/fonts.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/menu2snippets/gamemodes_hud/glimpse/glimpse.js" />
    </scripts>
    <Panel class="glimpseMenuMain">
        <Panel class="Col">
            <Label class="menu_button_label" text="#glimpse"/>
            <Label class="embeedingContentLabel" text="#glimpseInfo"/>
            <Label class="settingLabel" text="#glimpsePick"/>
            <Panel id="glimpseTypePicker" class="glimpseTypeGrid"/>
            <Panel class="RowNoFill" id="glimpseLevelRow">
                <Label class="settingLabel" text="#glimpseLevel"/>
                <RadioButton group="glimpseLevel" id="glimpseLvl1" class="customCheckbox" text="1"/>
                <RadioButton group="glimpseLevel" id="glimpseLvl2" class="customCheckbox" text="2"/>
                <RadioButton group="glimpseLevel" id="glimpseLvl3" class="customCheckbox" text="3" checked="true"/>
                <RadioButton group="glimpseLevel" id="glimpseLvl4" class="customCheckbox" text="4"/>
            </Panel>
            <Panel class="RowNoFill">
                <ToggleButton checked="true" id="timebarToggle" class="customCheckbox" text="#menuTimebar"/>
            </Panel>
            <Panel class="RowNoFill">
                <Button class="menu_button mode_play" id="menu_play" onactivate="startGame()">
                    <Label class="mode_play_label" id="menu_play_label" text="Play"/>
                </Button>
                <Label id="errorMsg"></Label>
            </Panel>
        </Panel>
    </Panel>
</root>
