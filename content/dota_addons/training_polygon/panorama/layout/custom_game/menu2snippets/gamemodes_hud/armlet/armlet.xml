<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/mainmenu_v2.css" />
        <include src="file://{resources}/styles/custom_game/menu2snippets/gamemodes_hud/armlet/armlet.css" />
        <include src="file://{resources}/styles/custom_game/fonts.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/menu2snippets/gamemodes_hud/armlet/armlet.js" />
    </scripts>
    <Panel class="armletMenuMain">
        <Panel class="Col">
            <Label class="menu_button_label" text="#armlet"/>
            <Label class="embeedingContentLabel" text="#armletInfo1"/>
            <Label class="settingLabel" text="#armletSettings1"/>
            <Panel id="armletUnitPicker" class="armletUnitGrid"/>
            <Panel class="RowNoFill">
                <Button class="menu_button mode_play" id="menu_play" onactivate="startGame()">
                    <Label class="mode_play_label" id="menu_play_label" text="Play"/>
                </Button>
                <Label id="errorMsg"></Label>
            </Panel>
        </Panel>
    </Panel>
</root>
