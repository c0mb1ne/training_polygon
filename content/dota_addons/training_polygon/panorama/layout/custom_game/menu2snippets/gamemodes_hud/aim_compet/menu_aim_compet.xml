<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/mainmenu_v2.css" />
        <include src="file://{resources}/styles/custom_game/menu2snippets/gamemodes_hud/aim_compet/menu_aim_compet.css" />
        <include src="file://{resources}/styles/custom_game/fonts.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/graph.js" />
        <include src="file://{resources}/scripts/custom_game/menu2snippets/gamemodes_hud/aim_compet/menu_aim_compet.js" />
    </scripts>
    <Panel class="aim_compet_Main">
        <Panel class="Col width100">
            <Label class="menu_button_label" text="#aim_compet"/>

            <Panel class="RowNoFill">
                <Panel class="Col">
                    <Panel class="RowNoFill">
                        <Label class="itemSetupDesc" text="#aimSetupDesc"/>
                        <DOTAItemImage itemname="item_topor" class="AimItemPreview"/>
                    </Panel>
                    <Panel class="RowNoFill AimSetupRow">
                        <Panel class="ColNoFill">
                            
                        </Panel>
                        <Panel class="ColNoFill AimGridContainer">
                            <Label class="AimGridLabel" text="Abilities"/>
                            <Panel id="aim_abilities_grid" class="RowNoFill">
                                <!-- cells are created by aim_compet.js -->
                            </Panel>
                        </Panel>

                        <Panel class="ColNoFill AimGridContainer">
                            <Label class="AimGridLabel" text="Items"/>
                            <Panel id="aim_items_grid" class="ColNoFill">
                                <!-- rows and cells are created by aim_compet.js -->
                            </Panel>
                        </Panel>
                    </Panel>
                </Panel>
            </Panel>

            <Panel class="RowNoFill AimSettingsRow">
                <Panel class="ColNoFill AimSettingsCol">
                    <Panel class="RowNoFill">
                        <Label class="AimGridLabel" text="#aimRoundSettings"/>
                        <Button class="small_button AimDefaultsButton" id="defaultsButton" onactivate="resetDefaults()">
                            <Label text="#aimDefaults"/>
                        </Button>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine">
                        <Label class="settingLabel" text="#aimRoundDuration"/>
                        <Panel id="roundTimeSwitcher"/>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine">
                        <Label class="settingLabel" text="#aimSpawnCurve"/>
                        <Panel class="radioRow" id="curveTypeRow">
                            <RadioButton group="aimCurveType" id="curveClassic" class="radioRowButton" checked="true">
                                <Label text="#aimCurveClassic"/>
                            </RadioButton>
                            <RadioButton group="aimCurveType" id="curveConstant" class="radioRowButton">
                                <Label text="#aimCurveConstant"/>
                            </RadioButton>
                            <RadioButton group="aimCurveType" id="curveLinear" class="radioRowButton">
                                <Label text="#aimCurveLinear"/>
                            </RadioButton>
                            <RadioButton group="aimCurveType" id="curvePower" class="radioRowButton">
                                <Label text="#aimCurvePower"/>
                            </RadioButton>
                        </Panel>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine">
                        <Label class="settingLabel" text="#aimStartInterval"/>
                        <Panel id="startIntervalSwitcher"/>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine" id="endIntervalRow">
                        <Label class="settingLabel" text="#aimEndInterval"/>
                        <Panel id="endIntervalSwitcher"/>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine Hidden" id="exponentRow">
                        <Label class="settingLabel" text="#aimCurveExponent"/>
                        <Panel id="exponentSwitcher"/>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine">
                        <Label class="settingLabel" text="#aimWardLifetime"/>
                        <Panel id="wardLifetimeSwitcher"/>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine">
                        <Label class="settingLabel" text="#aimPlayArea"/>
                        <Label id="areaSizeValue" class="AimEstimateValue" text="1500 × 1000"/>
                        <Button class="small_button AimDefaultsButton" id="areaPickButton" onactivate="pickArea()">
                            <Label text="#aimSetArea"/>
                        </Button>
                    </Panel>

                    <Panel class="RowNoFill AimSettingLine">
                        <Label class="settingLabel" text="#aimWardEstimate"/>
                        <Label id="wardEstimateValue" class="AimEstimateValue" text=""/>
                    </Panel>
                </Panel>

                <Panel class="ColNoFill AimCurveGraphCol">
                    <Panel id="curveGraphContainer"/>
                </Panel>
            </Panel>

            <Panel class="RowNoFill">
                <Button class="menu_button mode_play" id="menu_play" onactivate="startGame()">
                    <Label class="mode_play_label" id="menu_play_label" text="Play"/>
                </Button>
                <Label id="errorMsg"></Label>
            </Panel>
        </Panel>
    </Panel>
</root>
